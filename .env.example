# Backend
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=crop_health
JWT_SECRET=change-me-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Confidence thresholds (0-1)
CONFIDENCE_HIGH=0.75
CONFIDENCE_MEDIUM=0.50

# Risk level thresholds (0-100)
RISK_LOW_MAX=39
RISK_MODERATE_MAX=69

# Image limits
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Weather (optional — leave empty for demo/simulated data)
WEATHER_API_KEY=
WEATHER_API_URL=

# ML
MODEL_PATH=backend/ml/artifacts/model.keras
CLASS_MAP_PATH=backend/ml/artifacts/class_map.json

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend (Next.js) — copy this into frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000
